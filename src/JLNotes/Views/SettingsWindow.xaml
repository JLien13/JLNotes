<Window x:Class="JLNotes.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="400" Height="600"
        MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- SubtleButton that dims + disables until a project is selected. -->
        <Style x:Key="RequiresSelectionButton" TargetType="Button"
               BasedOn="{StaticResource SubtleButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=ProjectList}"
                             Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgPrimaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header (draggable) -->
            <Border Grid.Row="0" Padding="20,14"
                    Background="{DynamicResource BgSecondaryBrush}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" VerticalAlignment="Center" />
                    <Button Content="✕" HorizontalAlignment="Right"
                            Style="{StaticResource SubtleButton}"
                            FontSize="12" Padding="4,0"
                            Click="Close_Click" />
                </Grid>
            </Border>

            <!-- General settings -->
            <StackPanel Grid.Row="1" Margin="20,16,20,0">

                <!-- Theme -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Theme" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI" />
                    <ComboBox Grid.Column="1" x:Name="ThemeCombo"
                              Width="130"
                              Style="{StaticResource DarkComboBox}"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Light" />
                    </ComboBox>
                </Grid>

                <!-- Subtitle Display -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Show under title" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI" />
                    <ComboBox Grid.Column="1" x:Name="SubtitleCombo"
                              Width="130"
                              Style="{StaticResource DarkComboBox}"
                              SelectionChanged="SubtitleCombo_SelectionChanged">
                        <ComboBoxItem Content="Project" Tag="project" />
                        <ComboBoxItem Content="Repo" Tag="repo" />
                        <ComboBoxItem Content="Tags" Tag="tags" />
                    </ComboBox>
                </Grid>

                <!-- Close behavior -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Close button" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI" />
                    <ComboBox Grid.Column="1" x:Name="CloseBehaviorCombo"
                              Width="130"
                              Style="{StaticResource DarkComboBox}"
                              SelectionChanged="CloseBehaviorCombo_SelectionChanged">
                        <ComboBoxItem Content="Minimize to tray" Tag="tray" />
                        <ComboBoxItem Content="Quit app" Tag="quit" />
                    </ComboBox>
                </Grid>

                <!-- Confirm Delete -->
                <CheckBox x:Name="ConfirmDeleteCheck"
                          Content="Confirm before deleting notes"
                          Style="{StaticResource DarkCheckBox}"
                          FontFamily="Segoe UI"
                          Margin="0,0,0,10"
                          Checked="ConfirmDelete_Changed"
                          Unchecked="ConfirmDelete_Changed" />

                <!-- Auto-start. Reads/writes the HKCU Run value directly -->
                <CheckBox x:Name="AutoStartCheck"
                          Content="Launch JL Notes when Windows starts"
                          Style="{StaticResource DarkCheckBox}"
                          FontFamily="Segoe UI"
                          Margin="0,0,0,16"
                          Checked="AutoStart_Changed"
                          Unchecked="AutoStart_Changed" />
            </StackPanel>

            <!-- Projects -->
            <TextBlock Grid.Row="2" Text="Projects" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontFamily="Segoe UI" Margin="20,0,20,8" />

            <ListBox Grid.Row="3" x:Name="ProjectList"
                     Background="{DynamicResource BgSecondaryBrush}"
                     BorderBrush="{DynamicResource BorderSubtleBrush}"
                     BorderThickness="1"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontFamily="Segoe UI" FontSize="12"
                     Margin="20,0,20,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{Binding Repo}"
                                       ToolTip="{Binding Repo}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="20,0,20,8">
                <Button Content="+ Add"
                        Style="{StaticResource SubtleButton}"
                        Foreground="{DynamicResource AccentBlueBrush}"
                        Click="AddProject_Click" />
                <Button Content="Remove"
                        Style="{StaticResource RequiresSelectionButton}"
                        Click="RemoveProject_Click" />
                <Button Content="Browse Repo"
                        Style="{StaticResource RequiresSelectionButton}"
                        Click="BrowseProjectRepo_Click" />
            </StackPanel>

            <!-- Close -->
            <Button Grid.Row="5" Content="Close" HorizontalAlignment="Right"
                    Style="{StaticResource SubtleButton}"
                    Foreground="{DynamicResource AccentBlueBrush}"
                    Margin="20,0,20,16"
                    Click="Close_Click" />
        </Grid>
    </Border>
</Window>
