<Window x:Class="JLNotes.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History"
        Width="680" Height="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">

    <!-- One window for both kinds of history: a note's earlier versions (note
         menu > Earlier versions) and notes that were deleted (tray > Deleted notes).
         Pick an entry on the left, read it on the right, Restore puts it back. -->
    <Border Background="{DynamicResource BgPrimaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeadingText" Grid.Row="0"
                       FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,12"
                       MouseLeftButtonDown="Heading_MouseLeftButtonDown" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="VersionList" Grid.Column="0"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SplitListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="VersionList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6">
                                <TextBlock Text="{Binding When}" Style="{StaticResource BaseText}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SecondaryText}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText" Grid.Column="0" Grid.ColumnSpan="2"
                           Style="{StaticResource SecondaryText}"
                           Text="Nothing kept yet."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />

                <TextBox x:Name="Preview" Grid.Column="1" Margin="12,0,0,0"
                         IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource BgSecondaryBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                         FontFamily="Segoe UI" FontSize="13"
                         Padding="8,6" />
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Close"
                        Style="{StaticResource SubtleButton}"
                        Margin="0,0,8,0"
                        Click="Close_Click" />
                <Button x:Name="RestoreButton" Content="Restore"
                        Style="{StaticResource SubtleButton}"
                        Foreground="{DynamicResource AccentBlueBrush}"
                        IsEnabled="False"
                        Click="Restore_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
