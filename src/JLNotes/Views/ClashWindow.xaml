<Window x:Class="JLNotes.Views.ClashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Two versions"
        Width="900" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">

    <!-- A note changed in two places (two PCs, or the app and Claude) before either
         saw the other's change. Both versions side by side: keep one, or combine
         them. Whatever is not kept goes to Earlier Versions. -->
    <Border Background="{DynamicResource BgPrimaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12"
                        Background="Transparent"
                        MouseLeftButtonDown="Heading_MouseLeftButtonDown">
                <TextBlock x:Name="HeadingText"
                           FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="It was changed in two places before either saw the other. Pick the one to keep, or combine them. The one you don't keep goes to Earlier Versions." />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="ThisLabel"
                       Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="OtherLabel"
                       Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,0,6" />

            <TextBox Grid.Row="2" Grid.Column="0" x:Name="ThisText"
                     IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource BgSecondaryBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderSubtleBrush}"
                     FontFamily="Segoe UI" FontSize="13"
                     Padding="8,6" />
            <TextBox Grid.Row="2" Grid.Column="2" x:Name="OtherText"
                     IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource BgSecondaryBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderSubtleBrush}"
                     FontFamily="Segoe UI" FontSize="13"
                     Padding="8,6" />

            <Button Grid.Row="3" Grid.Column="0" Content="Keep this one"
                    Style="{StaticResource SubtleButton}"
                    Foreground="{DynamicResource AccentBlueBrush}"
                    HorizontalAlignment="Left" Margin="0,8,0,0"
                    Click="KeepThis_Click" />
            <Button Grid.Row="3" Grid.Column="2" Content="Keep this one"
                    Style="{StaticResource SubtleButton}"
                    Foreground="{DynamicResource AccentBlueBrush}"
                    HorizontalAlignment="Left" Margin="0,8,0,0"
                    Click="KeepOther_Click" />

            <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Decide later"
                        Style="{StaticResource SubtleButton}"
                        Margin="0,0,8,0"
                        Click="Later_Click" />
                <Button Content="Combine both"
                        Style="{StaticResource SubtleButton}"
                        Foreground="{DynamicResource AccentBlueBrush}"
                        ToolTip="Every line of both versions in one note, with tags from both. Title, project, priority and status come from the one in the note now (any it leaves empty, from the other). Tidy it up after."
                        Click="Combine_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
